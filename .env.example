# =============================================================================
# ProjectionAI — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit secrets.
# =============================================================================

# --- Application -----------------------------------------------------------
PROJECTIONAI_ENV=development        # development | production | staging
PROJECTIONAI_LOG_LEVEL=DEBUG        # DEBUG | INFO | WARNING | ERROR
PROJECTIONAI_DATA_DIR=              # Override default data directory (optional)

# --- AI Providers ----------------------------------------------------------
# At least one provider must be configured.
# Set the active provider via PROJECTIONAI_AI_PROVIDER.

PROJECTIONAI_AI_PROVIDER=gemini     # gemini | openai | anthropic | replicate

# Gemini
GEMINI_API_KEY=sk-your-key-here
GEMINI_MODEL=gemini-3.5-flash

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
OPENAI_ORG_ID=                      # Optional: OpenAI organization ID

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Replicate
REPLICATE_API_TOKEN=r8-your-token-here
REPLICATE_MODEL=stability-ai/stable-diffusion-3